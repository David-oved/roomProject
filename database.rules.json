{
  // ============================================================
  //  RoomMate — Firebase Realtime Database Security Rules
  //  הסבר מלא לכל כלל: docs/03-security-rules.md
  //  פריסה: firebase deploy --only database
  // ============================================================
  "rules": {
    // ברירת מחדל: הכל חסום. הרשאות ניתנות רק במפורש למטה.
    ".read": false,
    ".write": false,

    // ---------- פרופילי משתמשים ----------
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'displayName', 'createdAt'])",

        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254 && newData.val().matches(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$/)"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length <= 1000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
        },
        "lastActiveAt": { ".validate": "newData.isNumber()" },

        // מנהל חדר רשאי לכתוב כאן כדי לרשום משתמש שאושר לחדר.
        //
        // ‼️ תוקן: המנהל היה יכול לכתוב True כאן לכל uid שהוא מכיר, בלי
        // שהיעד יהיה חבר פעיל בפועל — "חדר רפאים" ברשימת החדרים של קורבן,
        // וגרוע מזה: כל כתיבה עתידית מרובת-נתיבים של הקורבן (למשל שינוי
        // שם/תמונה, שמתפזר לכל rooms שברשימתו) הייתה נכשלת *כולה* כי
        // הנתיב הפנטום הזה תמיד היה נכשל בחוקי members — מניעת שירות
        // לצמיתות על קורבן, בלי שהוא עשה כלום. עכשיו: יצירה/הפעלה של
        // הדגל מותרת למנהל רק כשהיעד כבר חבר פעיל (נכתב יחד באותה
        // עדכון אטומית ב-approveJoinRequest, ולכן נראה כבר "פעיל" בזמן
        // האימות) — מחיקה (עזיבה/הסרה) נשארת מותרת תמיד.
        "rooms": {
          "$roomCode": {
            ".write": "auth != null && (auth.uid === $uid || (root.child('rooms/' + $roomCode + '/metadata/adminId').val() === auth.uid && (!newData.exists() || root.child('rooms/' + $roomCode + '/members/' + $uid + '/status').val() === 'active')))",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },
        // ---------- מנויי התראות ----------
        // מנוי לכל מכשיר. המזהה נגזר מה-endpoint, ולכן רישום חוזר
        // מאותו מכשיר דורס את עצמו במקום ליצור רשומה כפולה.
        "pushSubscriptions": {
          "$subId": {
            ".validate": "newData.hasChildren(['endpoint', 'p256dh', 'auth'])",
            "endpoint":  { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length <= 600" },
            "p256dh":    { ".validate": "newData.isString() && newData.val().length <= 200" },
            "auth":      { ".validate": "newData.isString() && newData.val().length <= 100" },
            "platform":  { ".validate": "newData.val().matches(/^(ios|other)$/)" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other":    { ".validate": false }
          }
        },

        // כיבוי התראות בלי לבטל את המנוי במכשיר
        "pushEnabled": { ".validate": "newData.isBoolean()" },

        "$other": { ".validate": false }
      }
    },

    // ---------- תור התראות יוצאות ----------
    // הלקוח כותב לכאן כשקורה משהו שראוי להתראה. תהליך מתוזמן קורא
    // את התור, שולח, ומסמן כנשלח.
    //
    // אף לקוח לא קורא מכאן — השולח משתמש ב-Admin SDK שעוקף כללים
    // לגמרי. לכן .read נשאר false והתור בלתי נראה למשתמשים.
    "outbox": {
      ".read": false,
      "$entryId": {
        // יצירה בלבד, ורק ע"י חבר פעיל בחדר שעליו ההתראה — עם חריג יחיד:
        // מי ששלח בקשת הצטרפות ל-pendingRequests (עדיין לא חבר) מותר לו
        // להודיע *רק* למנהל האמיתי של אותו חדר *רק* כשהבקשה שלו קיימת
        // ו-pending. כך אין דרך להודיע למישהו אחר או על חדר אחר.
        // אין עריכה ואין מחיקה מהלקוח — כדי שאי אפשר יהיה לשנות התראה
        // שכבר בתור.
        //
        // ‼️ תוקן: audience='user' דרך הענף הרגיל (כל חבר פעיל בחדר) חייב
        // שה-targetUid יהיה חבר (גם אם הוסר) של אותו חדר בדיוק, או שהכותב
        // עצמו יהיה מנהל החדר. בלי זה, כל משתמש מחובר שהוא חבר בחדר כלשהו
        // (אפילו חדר משלו) יכול היה לשלוח התראת פוש מזויפת לכל uid שהוא
        // מכיר — כולל למשתמשים בחדרים אחרים לגמרי, פשוט על ידי ידיעת ה-uid
        // שלהם (שנחשף למשל דרך שדה createdBy בקטלוג הגלובלי).
        ".write": "auth != null && !data.exists() && newData.exists() && ((root.child('rooms/' + newData.child('roomCode').val() + '/members/' + auth.uid + '/status').val() === 'active' && (newData.child('audience').val() === 'room' || root.child('rooms/' + newData.child('roomCode').val() + '/members/' + newData.child('targetUid').val()).exists() || root.child('rooms/' + newData.child('roomCode').val() + '/metadata/adminId').val() === auth.uid)) || (newData.child('audience').val() === 'user' && newData.child('targetUid').val() === root.child('rooms/' + newData.child('roomCode').val() + '/metadata/adminId').val() && root.child('rooms/' + newData.child('roomCode').val() + '/pendingRequests/' + auth.uid + '/status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['roomCode', 'title', 'body', 'audience', 'priority', 'createdAt'])",

        "roomCode":   { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/)" },
        "title":      { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "body":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160" },
        "url":        { ".validate": "newData.isString() && newData.val().length <= 120" },
        "tag":        { ".validate": "newData.isString() && newData.val().length <= 40" },
        "audience":   { ".validate": "newData.val().matches(/^(room|user)$/)" },
        "priority":   { ".validate": "newData.val().matches(/^(now|digest)$/)" },
        "targetUid":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "excludeUid": { ".validate": "newData.val() === auth.uid" },
        "createdAt":  { ".validate": "newData.isNumber()" },
        "sentAt":     { ".validate": "newData.isNumber()" },
        "$other":     { ".validate": false }
      }
    },

    // ---------- אינדקס קודי חדרים (ציבורי למשתמשים מחוברים) ----------
    // מאפשר לבדוק "האם קוד החדר קיים?" בלי לחשוף את תוכן החדר.
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('adminId').val() === auth.uid) || (data.exists() && data.child('adminId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['name', 'adminId', 'createdAt']) && $code.matches(/^[A-Z0-9]{6}$/)",

        "name":      { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 50" },
        "adminId":   { ".validate": "newData.isString() && newData.val().length > 0" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
        "$other":    { ".validate": false }
      }
    },

    // ---------- אינדקס ייחודיות שמות חדרים ----------
    // נכתב ב-runTransaction.
    //
    // שלוש דרכים לכתוב כאן:
    //  1. השם פנוי.
    //  2. אתה מנהל החדר שמחזיק בשם.
    //  3. ‼️ השם "יתום" — מחזיק בקוד חדר שאינו קיים ב-roomCodes.
    //
    // הסעיף השלישי קריטי. תפיסת השם קורית **לפני** יצירת החדר, ואם
    // היצירה נכשלת באמצע נשאר שם תפוס שלא שייך לאף חדר. בלי הסעיף
    // הזה גם מנגנון הפיצוי נחסם — הוא דורש להיות מנהל של חדר שמעולם
    // לא נוצר — והשם ננעל לצמיתות. קרה בפועל, פעמיים.
    "roomNames": {
      "$slug": {
        ".read": "auth != null",
        // ‼️ תוקן: תפיסת שם "יתום" (ענף 3) חייבה בעבר שהערך הקודם יהיה
        // יתום, אבל לא הגבילה בכלל את מה שנכתב במקומו — כל משתמש מחובר
        // יכול היה לתפוס slug יתום ולהצביע אותו על קוד חדר קיים של מישהו
        // אחר לגמרי, בלי שום קשר אליו. עכשיו נדרש גם שהיעד החדש יהיה או
        // לא-קיים (השם המקורי לחדר עתידי שלך) או חדר שאתה כבר מנהל בו.
        ".write": "auth != null && ((!data.exists() && (!root.child('roomCodes/' + newData.val()).exists() || root.child('roomCodes/' + newData.val() + '/adminId').val() === auth.uid)) || (data.exists() && root.child('rooms/' + data.val() + '/metadata/adminId').val() === auth.uid) || (data.exists() && !root.child('roomCodes/' + data.val()).exists() && (!root.child('roomCodes/' + newData.val()).exists() || root.child('roomCodes/' + newData.val() + '/adminId').val() === auth.uid)))",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/) && $slug.length >= 2 && $slug.length <= 60"
      }
    },

    // ---------- מראה אישית של בקשות הצטרפות ----------
    // מאפשרת למשתמש לדעת שאושר, למרות שהוא עדיין לא חבר בחדר.
    "joinRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$roomCode": {
          ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $roomCode + '/metadata/adminId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['status', 'requestedAt'])",

          // המשתמש עצמו יכול לכתוב רק 'pending'. רק המנהל מאשר או דוחה.
          "status":      { ".validate": "newData.val().matches(/^(pending|approved|rejected)$/) && (auth.uid === $uid ? newData.val() === 'pending' : true)" },
          "requestedAt": { ".validate": "newData.isNumber()" },
          "respondedAt": { ".validate": "newData.isNumber()" },
          "roomName":    { ".validate": "newData.isString() && newData.val().length <= 50" },
          "$other":      { ".validate": false }
        }
      }
    },

    // ---------- קטלוג מוצרים גלובלי ----------
    // משותף לכל החדרים: מוצר שמישהו מוסיף זמין מיד לכולם.
    // המחירים כאן הם ברירת מחדל בלבד — לכל חדר יש עקיפה משלו.
    //
    // כתיבה: יצירה בלבד, או עדכון ע"י מי שיצר. בלי זה, שינוי שם של
    // מוצר פופולרי היה משפיע על כל החדרים במערכת בבת אחת.
    "catalog": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name', 'category', 'defaultPrice', 'createdBy'])",

        "name":         { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "nameLower":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "category":     { ".validate": "newData.val().matches(/^(kitchen|bathroom|cleaning|other)$/)" },
        "unit":         { ".validate": "newData.isString() && newData.val().length <= 20" },
        "defaultPrice": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
        "createdBy":    { ".validate": "newData.val() === auth.uid || (data.exists() && newData.val() === data.val())" },
        "createdAt":    { ".validate": "newData.isNumber()" },
        "$other":       { ".validate": false }
      }
    },

    // ================= חדרים =================
    "rooms": {
      "$code": {
        // קריאה לכל תת-העץ: חבר פעיל בלבד. חריגים מוגדרים בצמתים למטה.
        ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",

        // כתיבה ברמת החדר מותרת אך ורק כמחיקה מלאה על ידי המנהל.
        ".write": "auth != null && data.exists() && !newData.exists() && data.child('metadata/adminId').val() === auth.uid",

        // ---------- מטא-דאטה ----------
        "metadata": {
          // יצירה: היוצר חייב לרשום את עצמו כמנהל.  עדכון: המנהל בלבד.
          ".write": "auth != null && ((!data.exists() && newData.child('adminId').val() === auth.uid && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('adminId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['name', 'createdAt', 'createdBy', 'adminId'])",

          "name":        { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 50" },
          "description": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "photo":       { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/)" },
          "currency":    { ".validate": "newData.val() === 'ILS'" },
          "categories": {
            "$cat": { ".validate": "newData.isBoolean() && $cat.matches(/^(kitchen|bathroom|cleaning|other)$/)" }
          },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
          "createdBy": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
          // ‼️ תוקן: בלי הבדיקה השנייה, המנהל הנוכחי יכול היה (בטעות או
          // בבאג בלקוח) להצביע adminId על uid שאינו חבר פעיל בכלל —
          // ונועל את החדר בלי מנהל שיכול לתפעל אותו יותר.
          "adminId":   { ".validate": "newData.isString() && newData.val().length > 0 && (!data.exists() || newData.val() === data.val() || root.child('rooms/' + $code + '/members/' + newData.val() + '/status').val() === 'active')" },
          "$other":    { ".validate": false }
        },

        // ---------- חברים ----------
        "members": {
          ".indexOn": ["status"],
          "$uid": {
            // 1) המנהל מנהל את כל החברים.
            // 2) יוצר החדר מוסיף את עצמו כמנהל בזמן היצירה (עדיין אין metadata).
            // 3) חבר רגיל יכול רק לעזוב: מחיקה, או שינוי status ל-removed בלי לגעת ב-role.
            // 4) חבר רגיל יכול לעדכן את שם/תמונת הפרופיל של עצמו — role/status/
            //    joinedAt/email קפואים, כדי שלא יוכל לקדם את עצמו למנהל או
            //    לבטל הסרה. בלעדי הסעיף הזה שינוי שם/תמונה נכשל לכל מי שאינו מנהל.
            ".write": "auth != null && (root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid || (!root.child('rooms/' + $code + '/metadata').exists() && $uid === auth.uid && newData.child('role').val() === 'admin') || ($uid === auth.uid && data.exists() && root.child('rooms/' + $code + '/metadata/adminId').val() !== auth.uid && (!newData.exists() || (newData.child('status').val() === 'removed' && newData.child('role').val() === data.child('role').val()) || (newData.child('role').val() === data.child('role').val() && newData.child('status').val() === data.child('status').val() && newData.child('joinedAt').val() === data.child('joinedAt').val() && newData.child('email').val() === data.child('email').val()))))",

            ".validate": "newData.hasChildren(['name', 'email', 'joinedAt', 'status', 'role'])",
            "name":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
            "email":    { ".validate": "newData.isString() && newData.val().length <= 254" },
            "avatar":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "status":   { ".validate": "newData.val().matches(/^(active|removed)$/)" },
            "role":     { ".validate": "newData.val().matches(/^(admin|member)$/)" },
            "$other":   { ".validate": false }
          }
        },

        // ---------- בקשות הצטרפות ----------
        "pendingRequests": {
          ".read": "auth != null && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid",
          "$uid": {
            // המבקש קורא וכותב רק את הבקשה של עצמו, ורק אם אינו כבר חבר.
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((auth.uid === $uid && (!data.exists() || data.child('status').val() !== 'approved') && root.child('rooms/' + $code + '/metadata').exists() && !root.child('rooms/' + $code + '/members/' + auth.uid).exists()) || root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid)",

            ".validate": "newData.hasChildren(['userId', 'displayName', 'requestedAt', 'status'])",
            "userId":      { ".validate": "newData.val() === $uid" },
            "displayName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
            "email":       { ".validate": "newData.isString() && newData.val().length <= 254" },
            "avatar":      { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "requestedAt": { ".validate": "newData.isNumber()" },
            "respondedAt": { ".validate": "newData.isNumber()" },
            "status":      { ".validate": "newData.val().matches(/^(pending|approved|rejected)$/) && (auth.uid === $uid ? newData.val() === 'pending' : true)" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- מחירי הקטלוג של החדר ----------
        // עקיפה מקומית בלבד. שינוי כאן לא נוגע בשום חדר אחר.
        "catalogPrices": {
          "$productId": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",
            ".validate": "newData.hasChildren(['price'])",
            "price":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "updatedBy": { ".validate": "newData.val() === auth.uid" },
            "$other":    { ".validate": false }
          }
        },

        // ---------- מוצרי הבסיס של החדר ----------
        // מה שתמיד צריך להיות בבית. כל חבר פעיל יכול לעדכן.
        //
        // ‼️ הסעיף השני הוא "ביצה ותרנגולת": ביצירת חדר, מוצרי הבסיס
        // נכתבים באותה פעולה אטומית שיוצרת גם את החברות. ב-Security
        // Rules המשתנה root מייצג את המצב **לפני** הכתיבה, ולכן החבר
        // עדיין לא קיים והכלל הראשון נכשל — ואיתו כל יצירת החדר.
        // אותו דפוס בדיוק קיים בכלל של members.
        "staples": {
          // ‼️ ה-.write יושב כאן ולא על $productId, בכוונה.
          //
          // ב-RTDB, הרשאת כתיבה על צמתים בנים אינה מאפשרת לכתוב את
          // צומת האב עצמו. יצירת חדר כותבת את כל אובייקט ה-staples
          // במכה אחת, ולכן כלל שיושב רק על $productId היה חוסם אותה.
          // ברמה הזו הכלל מכסה גם כתיבה מלאה (יצירה) וגם כתיבה בודדת
          // (סימון מוצר), כי הרשאת כתיבה מדורגת כלפי מטה.
          //
          // הסעיף השני הוא "ביצה ותרנגולת": ביצירת חדר, root מייצג את
          // המצב לפני הכתיבה — ולכן החברות של היוצר עדיין לא קיימת.
          ".write": "auth != null && (root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' || !root.child('rooms/' + $code + '/metadata').exists())",
          "$productId": {
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },

        // ---------- מוצרים חסרים ----------
        "items": {
          ".indexOn": ["status", "category", "reportedAt", "priority"],
          "$itemId": {
            // יצירה : חבר פעיל בלבד, reportedBy = הוא עצמו, status מתחיל ב-needed.
            // עדכון : המדווח או המנהל — הכל.  חבר אחר — רק "תפיסת" הפריט,
            //         כלומר name/category/priority/reportedBy/reportedAt חייבים להישאר זהים.
            //         ‼️ תוקן: assignedTo בענף הזה מותר לשנות רק לעצמך או
            //         לנקות (בלי זה כל חבר יכול היה "לשייך" קנייה לחבר אחר
            //         בלי הסכמתו).
            // מחיקה : מנהל בלבד.
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && newData.child('reportedBy').val() === auth.uid && newData.child('status').val() === 'needed') || (data.exists() && newData.exists() && (data.child('reportedBy').val() === auth.uid || root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid || (newData.child('name').val() === data.child('name').val() && newData.child('category').val() === data.child('category').val() && newData.child('priority').val() === data.child('priority').val() && newData.child('reportedBy').val() === data.child('reportedBy').val() && newData.child('reportedAt').val() === data.child('reportedAt').val() && (!newData.hasChild('assignedTo') || newData.child('assignedTo').val() === auth.uid || newData.child('assignedTo').val() === data.child('assignedTo').val())))) || (data.exists() && !newData.exists() && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid))",

            ".validate": "newData.hasChildren(['name', 'category', 'reportedBy', 'reportedAt', 'priority', 'status'])",
            "name":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "nameLower":  { ".validate": "newData.isString() && newData.val().length <= 60" },
            "category":   { ".validate": "newData.val().matches(/^(kitchen|bathroom|cleaning|other)$/)" },
            "reportedBy": { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },
            "reportedAt": { ".validate": "newData.isNumber()" },
            "priority":   { ".validate": "newData.val().matches(/^(high|normal|low)$/)" },
            "status":     { ".validate": "newData.val().matches(/^(needed|buying|bought|done)$/)" },
            "assignedTo": { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val() + '/status').val() === 'active'" },
            "notes":      { ".validate": "newData.isString() && newData.val().length <= 500" },
            "purchaseId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "productId":  { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other":     { ".validate": false }
          }
        },

        // ---------- קניות (היומן הכספי) ----------
        "purchases": {
          ".indexOn": ["status", "createdAt", "boughtBy"],
          "$purchaseId": {
            // יצירה : חבר פעיל, boughtBy = הוא עצמו. status = pending (ימתין
            //         לאישור מנהל, נתיב עתידי) או approved עם approvedBy = הוא
            //         עצמו (אישור-עצמי — ברירת המחדל הנוכחית, ללא אישור מנהל).
            // עדכון : המנהל משנה סטטוס — אך amount ו-boughtBy קפואים לנצח.
            //         הקונה עורך רק כל עוד pending/rejected, ומחזיר ל-pending.
            // מחיקה : רק כשעדיין pending.
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && newData.child('boughtBy').val() === auth.uid && (newData.child('status').val() === 'pending' || (newData.child('status').val() === 'approved' && newData.child('approvedBy').val() === auth.uid))) || (data.exists() && newData.exists() && ((root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid && newData.child('amount').val() === data.child('amount').val() && newData.child('boughtBy').val() === data.child('boughtBy').val()) || (data.child('boughtBy').val() === auth.uid && (data.child('status').val() === 'pending' || data.child('status').val() === 'rejected') && newData.child('status').val() === 'pending'))) || (data.exists() && !newData.exists() && data.child('status').val() === 'pending' && (data.child('boughtBy').val() === auth.uid || root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid)))",

            ".validate": "newData.hasChildren(['boughtBy', 'amount', 'date', 'splitMethod', 'status', 'splitBetween', 'shares'])",
            "itemId":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "title":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "boughtBy": { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },

            // amount באגורות: מספר שלם חיובי בלבד, עד ₪100,000.
            // זה הכלל שחוסם "סכום שלילי" ו"סכום שברי" ברמת השרת.
            "amount": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000 && newData.val() % 1 === 0" },

            "date":        { ".validate": "newData.isNumber()" },
            "createdAt":   { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
            "splitMethod": { ".validate": "newData.val().matches(/^(equal|percentage|custom|covered|offset)$/)" },

            "splitBetween": {
              ".validate": "newData.hasChildren()",
              "$uid": { ".validate": "newData.isBoolean() && newData.val() === true && root.child('rooms/' + $code + '/members/' + $uid).exists()" }
            },
            // ‼️ מגבלה ידועה של RTDB Rules: אין דרך לוודא כאן ש-sum(shares)
            // === amount — השפה לא תומכת בסכימה על ילדים דינמיים. חבר
            // זדוני שכותב ישירות דרך ה-SDK (עוקף את computeShares בקוד,
            // שהיא הגנת UI בלבד) עדיין יכול לחלק amount קטן ל-shares
            // שמפלים לרעה משתתף אחד. שתי הגנות שכן אפשר לבטא במפורש:
            //  1. splitMethod === 'covered' (קונה יחיד): החלק שלו *חייב*
            //     להיות הסכום המלא — סוגר זיכוי-עצמי מומצא.
            //  2. כל share בודד חסום ב-amount של הקנייה עצמה — כך גם
            //     בחלוקה רב-משתתפים אי אפשר לחייב קורבן ביותר ממה
            //     שהקנייה "מכריזה" שהיא עלתה (ומ-amount יש כבר תקרה
            //     נפרדת של ₪100,000).
            // עדיין לא סגור לגמרי: shares יכולים לזקוף הכל לקורבן אחד
            // בלי לחייב את התוקף בכלל. סגירה מלאה דורשת בדיקת תקינות
            // מחזורית בצד שרת (יש כבר Cloudflare Worker + GitHub Action
            // עם הרשאות Admin SDK בפרויקט לצורך כזה) — לא נבנה כאן,
            // מסומן לדיון מוצרי נפרד.
            "shares": {
              ".validate": "newData.hasChildren() && (newData.parent().child('splitMethod').val() !== 'covered' || newData.child(newData.parent().child('boughtBy').val()).val() === newData.parent().child('amount').val())",
              "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().parent().child('amount').val() && newData.val() % 1 === 0 && newData.parent().parent().child('splitBetween/' + $uid).val() === true" }
            },

            "receipt":    { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/)" },
            "status":     { ".validate": "newData.val().matches(/^(pending|approved|rejected|settled)$/)" },
            "approvedBy": { ".validate": "newData.val() === auth.uid || root.child('rooms/' + $code + '/metadata/adminId').val() === newData.val()" },
            "note":       { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$other":     { ".validate": false }
          }
        },

        // ---------- מאזנים (מטמון תצוגה בלבד) ----------
        // מקור האמת הוא purchases. נכתב רק ע"י המנהל בעת אישור קנייה,
        // וניתן למחיקה ובנייה מחדש בכל רגע מתוך היומן.
        "balances": {
          ".write": "auth != null && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid",
          "$uid": {
            "amount":      { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "lastUpdated": { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- סגירות חשבון ----------
        // יוצר: המשלם או המקבל. אישור: רק המקבל, ובלי לשנות את הסכום.
        "settlements": {
          ".indexOn": ["date", "from", "to"],
          "$settlementId": {
            // ‼️ תוקן: to לא היה קפוא בענף העדכון (רק amount/from) — הנמען
            // שמאשר קבלה יכל תיאורטית להפנות את ה-to למישהו אחר תוך כדי
            // האישור. עכשיו קפוא גם הוא.
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && (newData.child('from').val() === auth.uid || newData.child('to').val() === auth.uid)) || (data.exists() && newData.exists() && data.child('to').val() === auth.uid && newData.child('amount').val() === data.child('amount').val() && newData.child('from').val() === data.child('from').val() && newData.child('to').val() === data.child('to').val()))",
            ".validate": "newData.hasChildren(['from', 'to', 'amount', 'date'])",
            "from":        { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },
            "to":          { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists() && newData.val() !== newData.parent().child('from').val()" },
            "amount":      { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000 && newData.val() % 1 === 0" },
            "date":        { ".validate": "newData.isNumber()" },
            "confirmedBy": { ".validate": "newData.val() === newData.parent().child('to').val()" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- התראות ----------
        // נשמרות בתוך החדר ולא בתיבה אישית, כדי שלא ניאלץ לתת לחבר אחד
        // הרשאת כתיבה לתיבה של חבר אחר. כל אחד מסמן "נקרא" רק לעצמו.
        "notifications": {
          ".indexOn": ["createdAt"],
          "$notificationId": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && (!data.exists() || root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['type', 'actorId', 'text', 'createdAt'])",
            "type":      { ".validate": "newData.val().matches(/^(item_added|item_claimed|item_bought|purchase_made|purchase_approved|purchase_rejected|member_joined|member_removed|settlement)$/)" },
            "actorId":   { ".validate": "newData.val() === auth.uid || root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid" },
            "actorName": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "text":      { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
            "entityId":  { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "readBy": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.isBoolean() && newData.val() === true"
              }
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
