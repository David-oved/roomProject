{
  // ============================================================
  //  RoomMate — Firebase Realtime Database Security Rules
  //  הסבר מלא לכל כלל: docs/03-security-rules.md
  //  פריסה: firebase deploy --only database
  // ============================================================
  "rules": {
    // ברירת מחדל: הכל חסום. הרשאות ניתנות רק במפורש למטה.
    ".read": false,
    ".write": false,

    // ---------- פרופילי משתמשים ----------
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'displayName', 'createdAt'])",

        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254 && newData.val().matches(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$/)"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "avatar": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length <= 1000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
        },
        "lastActiveAt": { ".validate": "newData.isNumber()" },

        // מנהל חדר רשאי לכתוב כאן כדי לרשום משתמש שאושר לחדר.
        //
        // ‼️ תוקן: המנהל היה יכול לכתוב True כאן לכל uid שהוא מכיר, בלי
        // שהיעד יהיה חבר פעיל בפועל — "חדר רפאים" ברשימת החדרים של קורבן,
        // וגרוע מזה: כל כתיבה עתידית מרובת-נתיבים של הקורבן (למשל שינוי
        // שם/תמונה, שמתפזר לכל rooms שברשימתו) הייתה נכשלת *כולה* כי
        // הנתיב הפנטום הזה תמיד היה נכשל בחוקי members — מניעת שירות
        // לצמיתות על קורבן, בלי שהוא עשה כלום. עכשיו: יצירה/הפעלה של
        // הדגל מותרת למנהל רק כשהיעד כבר חבר פעיל (נכתב יחד באותה
        // עדכון אטומית ב-approveJoinRequest, ולכן נראה כבר "פעיל" בזמן
        // האימות) — מחיקה (עזיבה/הסרה) נשארת מותרת תמיד.
        "rooms": {
          "$roomCode": {
            ".write": "auth != null && (auth.uid === $uid || (root.child('rooms/' + $roomCode + '/metadata/adminId').val() === auth.uid && (!newData.exists() || root.child('rooms/' + $roomCode + '/members/' + $uid + '/status').val() === 'active')))",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },
        // ---------- מנויי התראות ----------
        // מנוי לכל מכשיר. המזהה נגזר מה-endpoint, ולכן רישום חוזר
        // מאותו מכשיר דורס את עצמו במקום ליצור רשומה כפולה.
        "pushSubscriptions": {
          "$subId": {
            ".validate": "newData.hasChildren(['endpoint', 'p256dh', 'auth'])",
            "endpoint":  { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length <= 600" },
            "p256dh":    { ".validate": "newData.isString() && newData.val().length <= 200" },
            "auth":      { ".validate": "newData.isString() && newData.val().length <= 100" },
            "platform":  { ".validate": "newData.val().matches(/^(ios|other)$/)" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other":    { ".validate": false }
          }
        },

        // כיבוי התראות בלי לבטל את המנוי במכשיר
        "pushEnabled": { ".validate": "newData.isBoolean()" },

        "$other": { ".validate": false }
      }
    },

    // ---------- תור התראות יוצאות ----------
    // הלקוח כותב לכאן כשקורה משהו שראוי להתראה. תהליך מתוזמן קורא
    // את התור, שולח, ומסמן כנשלח.
    //
    // אף לקוח לא קורא מכאן — השולח משתמש ב-Admin SDK שעוקף כללים
    // לגמרי. לכן .read נשאר false והתור בלתי נראה למשתמשים.
    "outbox": {
      ".read": false,
      "$entryId": {
        // יצירה בלבד, ורק ע"י חבר פעיל בחדר שעליו ההתראה — עם חריג יחיד:
        // מי ששלח בקשת הצטרפות ל-pendingRequests (עדיין לא חבר) מותר לו
        // להודיע *רק* למנהל האמיתי של אותו חדר *רק* כשהבקשה שלו קיימת
        // ו-pending. כך אין דרך להודיע למישהו אחר או על חדר אחר.
        // אין עריכה ואין מחיקה מהלקוח — כדי שאי אפשר יהיה לשנות התראה
        // שכבר בתור.
        //
        // ‼️ תוקן (סבב 2): audience='user' דרך הענף הרגיל (כל חבר פעיל בחדר)
        // חייב שה-targetUid יהיה חבר (גם אם הוסר) של אותו חדר בדיוק.
        //
        // הגרסה הקודמת הוסיפה כאן חלופה "או שהכותב הוא מנהל החדר" — וזה
        // ביטל את ההגבלה לגמרי: כל משתמש יכול ליצור חדר משלו ולהיות המנהל
        // שלו, ומשם לשגר התראת פוש מזויפת לכל uid שהוא מכיר (uid נחשף למשל
        // דרך createdBy בקטלוג הגלובלי). "מנהל" אינו הרשאה נדירה במערכת
        // הזו — הוא ברירת המחדל של כל יוצר חדר.
        //
        // מה שכן נשאר למנהל, בצמצום: להודיע למי שיש לו רשומת pendingRequests
        // פתוחה בחדר שלו. זה נדרש ל-rejectJoinRequest — הנדחה כבר אינו
        // ולא היה חבר, ובלי החריג הזה הוא לא היה מקבל את הודעת הדחייה.
        // הצמצום אמיתי כי pendingRequests/$uid נסגר עכשיו ליצירה בידי
        // המנהל (ראו שם) — כלומר היעד חייב להיות מישהו שביקש להצטרף בעצמו.
        ".write": "auth != null && !data.exists() && newData.exists() && ((root.child('rooms/' + newData.child('roomCode').val() + '/members/' + auth.uid + '/status').val() === 'active' && (newData.child('audience').val() === 'room' || root.child('rooms/' + newData.child('roomCode').val() + '/members/' + newData.child('targetUid').val()).exists() || (root.child('rooms/' + newData.child('roomCode').val() + '/metadata/adminId').val() === auth.uid && root.child('rooms/' + newData.child('roomCode').val() + '/pendingRequests/' + newData.child('targetUid').val()).exists()))) || (newData.child('audience').val() === 'user' && newData.child('targetUid').val() === root.child('rooms/' + newData.child('roomCode').val() + '/metadata/adminId').val() && root.child('rooms/' + newData.child('roomCode').val() + '/pendingRequests/' + auth.uid + '/status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['roomCode', 'title', 'body', 'audience', 'priority', 'createdAt'])",

        "roomCode":   { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/)" },
        "title":      { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "body":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160" },
        // ‼️ תוקן: הערך הזה מגיע ל-window.location.hash ב-main.tsx (דרך
        // ההתראה וה-Service Worker). מחרוזת חופשית אפשרה להזריק לשם כל דבר.
        // עכשיו: נתיב פנימי בלבד — נפתח ב-/ , תו שני שאינו / (חוסם
        // "//evil.example" יחסי-פרוטוקול), ובלי ':' ולכן בלי javascript:.
        // כל הקריאות באפליקציה מתאימות: /r/{code}/items , /onboarding ,
        // /r/{code}/chat/dm/{uid} , /r/{code}/settings/members .
        "url":        { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^\\/([A-Za-z0-9_-][A-Za-z0-9\\/_-]*)?$/)" },
        "tag":        { ".validate": "newData.isString() && newData.val().length <= 40" },
        "audience":   { ".validate": "newData.val().matches(/^(room|user)$/)" },
        "priority":   { ".validate": "newData.val().matches(/^(now|digest)$/)" },
        "targetUid":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "excludeUid": { ".validate": "newData.val() === auth.uid" },
        "createdAt":  { ".validate": "newData.isNumber()" },
        "sentAt":     { ".validate": "newData.isNumber()" },
        "$other":     { ".validate": false }
      }
    },

    // ---------- אינדקס קודי חדרים (ציבורי למשתמשים מחוברים) ----------
    // מאפשר לבדוק "האם קוד החדר קיים?" בלי לחשוף את תוכן החדר.
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('adminId').val() === auth.uid) || (data.exists() && data.child('adminId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['name', 'adminId', 'createdAt']) && $code.matches(/^[A-Z0-9]{6}$/)",

        "name":      { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 50" },
        "adminId":   { ".validate": "newData.isString() && newData.val().length > 0" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
        "$other":    { ".validate": false }
      }
    },

    // ---------- אינדקס ייחודיות שמות חדרים ----------
    // נכתב ב-runTransaction.
    //
    // שלוש דרכים לכתוב כאן:
    //  1. השם פנוי.
    //  2. אתה מנהל החדר שמחזיק בשם.
    //  3. ‼️ השם "יתום" — מחזיק בקוד חדר שאינו קיים ב-roomCodes.
    //
    // הסעיף השלישי קריטי. תפיסת השם קורית **לפני** יצירת החדר, ואם
    // היצירה נכשלת באמצע נשאר שם תפוס שלא שייך לאף חדר. בלי הסעיף
    // הזה גם מנגנון הפיצוי נחסם — הוא דורש להיות מנהל של חדר שמעולם
    // לא נוצר — והשם ננעל לצמיתות. קרה בפועל, פעמיים.
    "roomNames": {
      "$slug": {
        ".read": "auth != null",
        // ‼️ תוקן: תפיסת שם "יתום" (ענף 3) חייבה בעבר שהערך הקודם יהיה
        // יתום, אבל לא הגבילה בכלל את מה שנכתב במקומו — כל משתמש מחובר
        // יכול היה לתפוס slug יתום ולהצביע אותו על קוד חדר קיים של מישהו
        // אחר לגמרי, בלי שום קשר אליו. עכשיו נדרש גם שהיעד החדש יהיה או
        // לא-קיים (השם המקורי לחדר עתידי שלך) או חדר שאתה כבר מנהל בו.
        ".write": "auth != null && ((!data.exists() && (!root.child('roomCodes/' + newData.val()).exists() || root.child('roomCodes/' + newData.val() + '/adminId').val() === auth.uid)) || (data.exists() && root.child('rooms/' + data.val() + '/metadata/adminId').val() === auth.uid) || (data.exists() && !root.child('roomCodes/' + data.val()).exists() && (!root.child('roomCodes/' + newData.val()).exists() || root.child('roomCodes/' + newData.val() + '/adminId').val() === auth.uid)))",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/) && $slug.length >= 2 && $slug.length <= 60"
      }
    },

    // ---------- מראה אישית של בקשות הצטרפות ----------
    // מאפשרת למשתמש לדעת שאושר, למרות שהוא עדיין לא חבר בחדר.
    "joinRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$roomCode": {
          ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $roomCode + '/metadata/adminId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['status', 'requestedAt'])",

          // המשתמש עצמו יכול לכתוב רק 'pending'. רק המנהל מאשר או דוחה.
          "status":      { ".validate": "newData.val().matches(/^(pending|approved|rejected)$/) && (auth.uid === $uid ? newData.val() === 'pending' : true)" },
          "requestedAt": { ".validate": "newData.isNumber()" },
          "respondedAt": { ".validate": "newData.isNumber()" },
          "roomName":    { ".validate": "newData.isString() && newData.val().length <= 50" },
          "$other":      { ".validate": false }
        }
      }
    },

    // ---------- קטלוג מוצרים גלובלי ----------
    // משותף לכל החדרים: מוצר שמישהו מוסיף זמין מיד לכולם.
    // המחירים כאן הם ברירת מחדל בלבד — לכל חדר יש עקיפה משלו.
    //
    // כתיבה: יצירה בלבד, או עדכון ע"י מי שיצר. בלי זה, שינוי שם של
    // מוצר פופולרי היה משפיע על כל החדרים במערכת בבת אחת.
    "catalog": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name', 'category', 'defaultPrice', 'createdBy'])",

        "name":         { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "nameLower":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "category":     { ".validate": "newData.val().matches(/^(kitchen|bathroom|cleaning|other)$/)" },
        "unit":         { ".validate": "newData.isString() && newData.val().length <= 20" },
        "defaultPrice": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
        "createdBy":    { ".validate": "newData.val() === auth.uid || (data.exists() && newData.val() === data.val())" },
        "createdAt":    { ".validate": "newData.isNumber()" },
        "$other":       { ".validate": false }
      }
    },

    // ================= חדרים =================
    "rooms": {
      "$code": {
        // קריאה לכל תת-העץ: חבר פעיל בלבד. חריגים מוגדרים בצמתים למטה.
        ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",

        // כתיבה ברמת החדר מותרת אך ורק כמחיקה מלאה על ידי המנהל.
        ".write": "auth != null && data.exists() && !newData.exists() && data.child('metadata/adminId').val() === auth.uid",

        // ---------- מטא-דאטה ----------
        "metadata": {
          // יצירה: היוצר חייב לרשום את עצמו כמנהל.  עדכון: המנהל בלבד.
          ".write": "auth != null && ((!data.exists() && newData.child('adminId').val() === auth.uid && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('adminId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['name', 'createdAt', 'createdBy', 'adminId'])",

          "name":        { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 50" },
          "description": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "photo":       { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/)" },
          "currency":    { ".validate": "newData.val() === 'ILS'" },
          "categories": {
            "$cat": { ".validate": "newData.isBoolean() && $cat.matches(/^(kitchen|bathroom|cleaning|other)$/)" }
          },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
          "createdBy": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
          // ‼️ תוקן: בלי הבדיקה השנייה, המנהל הנוכחי יכול היה (בטעות או
          // בבאג בלקוח) להצביע adminId על uid שאינו חבר פעיל בכלל —
          // ונועל את החדר בלי מנהל שיכול לתפעל אותו יותר.
          "adminId":   { ".validate": "newData.isString() && newData.val().length > 0 && (!data.exists() || newData.val() === data.val() || root.child('rooms/' + $code + '/members/' + newData.val() + '/status').val() === 'active')" },
          "$other":    { ".validate": false }
        },

        // ---------- חברים ----------
        "members": {
          ".indexOn": ["status"],
          "$uid": {
            // 1) המנהל מנהל את כל החברים.
            // 2) יוצר החדר מוסיף את עצמו כמנהל בזמן היצירה (עדיין אין metadata).
            // 3) חבר רגיל יכול רק לעזוב: מחיקה, או שינוי status ל-removed בלי לגעת ב-role.
            // 4) חבר רגיל יכול לעדכן את שם/תמונת הפרופיל של עצמו — role/status/
            //    joinedAt/email קפואים, כדי שלא יוכל לקדם את עצמו למנהל או
            //    לבטל הסרה. בלעדי הסעיף הזה שינוי שם/תמונה נכשל לכל מי שאינו מנהל.
            ".write": "auth != null && (root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid || (!root.child('rooms/' + $code + '/metadata').exists() && $uid === auth.uid && newData.child('role').val() === 'admin') || ($uid === auth.uid && data.exists() && root.child('rooms/' + $code + '/metadata/adminId').val() !== auth.uid && (!newData.exists() || (newData.child('status').val() === 'removed' && newData.child('role').val() === data.child('role').val()) || (newData.child('role').val() === data.child('role').val() && newData.child('status').val() === data.child('status').val() && newData.child('joinedAt').val() === data.child('joinedAt').val() && newData.child('email').val() === data.child('email').val()))))",

            ".validate": "newData.hasChildren(['name', 'email', 'joinedAt', 'status', 'role'])",
            "name":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
            "email":    { ".validate": "newData.isString() && newData.val().length <= 254" },
            // ‼️ תוקן: יושר לכלל הקנוני של users/$uid/avatar (שורה ~26) —
            // חובה https://. קודם התקבלה כל מחרוזת, ולכן חבר יכול היה לשתול
            // כאן URL של משואת מעקב ("http://tracker/?u=" או data:) שנטענת
            // בדפדפן של **כל** שותף לחדר בכל רינדור של רשימת החברים.
            "avatar":   { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length <= 1000" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "status":   { ".validate": "newData.val().matches(/^(active|removed)$/)" },
            "role":     { ".validate": "newData.val().matches(/^(admin|member)$/)" },
            "$other":   { ".validate": false }
          }
        },

        // ---------- נוכחות כללית ("מחובר לאפליקציה") ----------
        // נכתב פעם אחת כל עוד RoomProvider מותקן (כלומר כל עוד המשתמש
        // איפשהו בתוך החדר, לא רק בצ'אט) עם onDisconnect כרשת ביטחון.
        // בכוונה $uid יחיד ולא לפי מזהה חיבור — כמו chatPresence למטה,
        // מספיק פשוט לגודל החדרים כאן (כמה חברים, לרוב מכשיר אחד לאיש).
        "online": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },

        // ---------- בקשות הצטרפות ----------
        "pendingRequests": {
          ".read": "auth != null && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid",
          "$uid": {
            // המבקש קורא וכותב רק את הבקשה של עצמו, ורק אם אינו כבר חבר.
            ".read": "auth != null && auth.uid === $uid",
            // ‼️ תוקן: ענף המנהל הוגבל ל-(data.exists() || !newData.exists()) —
            // כלומר המנהל מעדכן בקשה קיימת (approved/rejected) ומוחק בקשות,
            // אבל **לא יוצר** בקשה חדשה בשם uid זר. בלי ההגבלה הזו המנהל היה
            // יכול לשתול pendingRequests/<קורבן> ואז "להודיע" לו — מה שהיה
            // עוקף בשני צעדים את ההגבלה החדשה ב-outbox.
            // ‼️ תוקן: נוסף ענף ראשון (auth.uid === $uid && !newData.exists())
            // — כל משתמש רשאי למחוק ללא תנאי את רשומת הבקשה **של עצמו**.
            // בלעדיו leaveRoom נכשל לכל מי שאינו מנהל: הענף השני (המבקש
            // הטרי) דורש !members.exists(), ששקרי לחבר פעיל שעוזב, והענף
            // השלישי (מנהל) שקרי כשהעוזב אינו המנהל. מחיקת הצומת של עצמך
            // בטוחה ללא תנאי נוסף — אין בה חשיפת מידע או שינוי הרשאה.
            ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (auth.uid === $uid && (!data.exists() || data.child('status').val() !== 'approved') && root.child('rooms/' + $code + '/metadata').exists() && !root.child('rooms/' + $code + '/members/' + auth.uid).exists()) || (root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid && (data.exists() || !newData.exists())))",

            ".validate": "newData.hasChildren(['userId', 'displayName', 'requestedAt', 'status'])",
            "userId":      { ".validate": "newData.val() === $uid" },
            "displayName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
            "email":       { ".validate": "newData.isString() && newData.val().length <= 254" },
            // ‼️ תוקן: כמו ב-members/avatar. כאן זה חמור יותר — בקשת הצטרפות
            // יכול לשלוח **זר** שיודע רק את קוד החדר, והתמונה נטענת אוטומטית
            // במסך "בקשות ממתינות" של המנהל. משואה כזו הייתה מדליפה למי
            // שאינו חבר בחדר את ה-IP, ה-User-Agent ומועד הצפייה של המנהל.
            "avatar":      { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/) && newData.val().length <= 1000" },
            "requestedAt": { ".validate": "newData.isNumber()" },
            "respondedAt": { ".validate": "newData.isNumber()" },
            "status":      { ".validate": "newData.val().matches(/^(pending|approved|rejected)$/) && (auth.uid === $uid ? newData.val() === 'pending' : true)" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- מחירי הקטלוג של החדר ----------
        // עקיפה מקומית בלבד. שינוי כאן לא נוגע בשום חדר אחר.
        "catalogPrices": {
          "$productId": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",
            ".validate": "newData.hasChildren(['price'])",
            "price":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "updatedBy": { ".validate": "newData.val() === auth.uid" },
            "$other":    { ".validate": false }
          }
        },

        // ---------- מוצרי הבסיס של החדר ----------
        // מה שתמיד צריך להיות בבית. כל חבר פעיל יכול לעדכן.
        //
        // ‼️ הסעיף השני הוא "ביצה ותרנגולת": ביצירת חדר, מוצרי הבסיס
        // נכתבים באותה פעולה אטומית שיוצרת גם את החברות. ב-Security
        // Rules המשתנה root מייצג את המצב **לפני** הכתיבה, ולכן החבר
        // עדיין לא קיים והכלל הראשון נכשל — ואיתו כל יצירת החדר.
        // אותו דפוס בדיוק קיים בכלל של members.
        "staples": {
          // ‼️ ה-.write יושב כאן ולא על $productId, בכוונה.
          //
          // ב-RTDB, הרשאת כתיבה על צמתים בנים אינה מאפשרת לכתוב את
          // צומת האב עצמו. יצירת חדר כותבת את כל אובייקט ה-staples
          // במכה אחת, ולכן כלל שיושב רק על $productId היה חוסם אותה.
          // ברמה הזו הכלל מכסה גם כתיבה מלאה (יצירה) וגם כתיבה בודדת
          // (סימון מוצר), כי הרשאת כתיבה מדורגת כלפי מטה.
          //
          // הסעיף השני הוא "ביצה ותרנגולת": ביצירת חדר, root מייצג את
          // המצב לפני הכתיבה — ולכן החברות של היוצר עדיין לא קיימת.
          ".write": "auth != null && (root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' || !root.child('rooms/' + $code + '/metadata').exists())",
          "$productId": {
            ".validate": "newData.isBoolean() && newData.val() === true"
          }
        },

        // ---------- מוצרים חסרים ----------
        "items": {
          ".indexOn": ["status", "category", "reportedAt", "priority"],
          "$itemId": {
            // יצירה : חבר פעיל בלבד, reportedBy = הוא עצמו, status מתחיל ב-needed.
            // עדכון : המדווח או המנהל — הכל.  חבר אחר — רק "תפיסת" הפריט,
            //         כלומר name/category/priority/reportedBy/reportedAt חייבים להישאר זהים.
            //         ‼️ תוקן: assignedTo בענף הזה מותר לשנות רק לעצמך או
            //         לנקות (בלי זה כל חבר יכול היה "לשייך" קנייה לחבר אחר
            //         בלי הסכמתו).
            // מחיקה : מנהל בלבד.
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && newData.child('reportedBy').val() === auth.uid && newData.child('status').val() === 'needed') || (data.exists() && newData.exists() && (data.child('reportedBy').val() === auth.uid || root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid || (newData.child('name').val() === data.child('name').val() && newData.child('category').val() === data.child('category').val() && newData.child('priority').val() === data.child('priority').val() && newData.child('reportedBy').val() === data.child('reportedBy').val() && newData.child('reportedAt').val() === data.child('reportedAt').val() && (!newData.hasChild('assignedTo') || newData.child('assignedTo').val() === auth.uid || newData.child('assignedTo').val() === data.child('assignedTo').val())))) || (data.exists() && !newData.exists() && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid))",

            ".validate": "newData.hasChildren(['name', 'category', 'reportedBy', 'reportedAt', 'priority', 'status'])",
            "name":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "nameLower":  { ".validate": "newData.isString() && newData.val().length <= 60" },
            "category":   { ".validate": "newData.val().matches(/^(kitchen|bathroom|cleaning|other)$/)" },
            "reportedBy": { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },
            "reportedAt": { ".validate": "newData.isNumber()" },
            "priority":   { ".validate": "newData.val().matches(/^(high|normal|low)$/)" },
            "status":     { ".validate": "newData.val().matches(/^(needed|buying|bought|done)$/)" },
            "assignedTo": { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val() + '/status').val() === 'active'" },
            "notes":      { ".validate": "newData.isString() && newData.val().length <= 500" },
            "purchaseId": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "productId":  { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other":     { ".validate": false }
          }
        },

        // ---------- קניות (היומן הכספי) ----------
        "purchases": {
          ".indexOn": ["status", "createdAt", "boughtBy"],
          "$purchaseId": {
            // יצירה : חבר פעיל, boughtBy = הוא עצמו. status = pending (ימתין
            //         לאישור מנהל, נתיב עתידי) או approved עם approvedBy = הוא
            //         עצמו (אישור-עצמי — ברירת המחדל הנוכחית, ללא אישור מנהל).
            // עדכון : המנהל משנה סטטוס — אך amount ו-boughtBy קפואים לנצח.
            //         הקונה עורך רק כל עוד pending/rejected, ומחזיר ל-pending.
            // מחיקה : הקונה — רק כל עוד pending.  המנהל — בכל סטטוס.
            //         ‼️ תוקן: קודם גם המנהל היה חסום ל-pending בלבד. מכיוון
            //         שקניות נכנסות ישר כ-approved (אישור עצמי, ראו ההערה
            //         ב-purchaseService.createPurchase), רשומה שגויה או
            //         זדונית נכנסה כ-approved ואז **אף אחד** לא יכול היה
            //         להסיר אותה — היא נשארה במאזן לנצח. זו פתחת החירום.
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && newData.child('boughtBy').val() === auth.uid && (newData.child('status').val() === 'pending' || (newData.child('status').val() === 'approved' && newData.child('approvedBy').val() === auth.uid))) || (data.exists() && newData.exists() && ((root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid && newData.child('amount').val() === data.child('amount').val() && newData.child('boughtBy').val() === data.child('boughtBy').val()) || (data.child('boughtBy').val() === auth.uid && (data.child('status').val() === 'pending' || data.child('status').val() === 'rejected') && newData.child('status').val() === 'pending'))) || (data.exists() && !newData.exists() && (root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid || (data.child('status').val() === 'pending' && data.child('boughtBy').val() === auth.uid))))",

            ".validate": "newData.hasChildren(['boughtBy', 'amount', 'date', 'splitMethod', 'status', 'splitBetween', 'shares'])",
            "itemId":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "title":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "boughtBy": { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },

            // amount באגורות: מספר שלם חיובי בלבד, עד ₪100,000.
            // זה הכלל שחוסם "סכום שלילי" ו"סכום שברי" ברמת השרת.
            "amount": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000 && newData.val() % 1 === 0" },

            "date":        { ".validate": "newData.isNumber()" },
            "createdAt":   { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
            "splitMethod": { ".validate": "newData.val().matches(/^(equal|percentage|custom|covered|offset)$/)" },

            "splitBetween": {
              ".validate": "newData.hasChildren()",
              "$uid": { ".validate": "newData.isBoolean() && newData.val() === true && root.child('rooms/' + $code + '/members/' + $uid).exists()" }
            },
            // ‼️ מגבלה ידועה של RTDB Rules: אין דרך לוודא כאן ש-sum(shares)
            // === amount — השפה לא תומכת בסכימה על ילדים דינמיים. חבר
            // זדוני שכותב ישירות דרך ה-SDK (עוקף את computeShares בקוד,
            // שהיא הגנת UI בלבד) עדיין יכול לחלק amount קטן ל-shares
            // שמפלים לרעה משתתף אחד. שתי הגנות שכן אפשר לבטא במפורש:
            //  1. splitMethod === 'covered' (קונה יחיד): החלק שלו *חייב*
            //     להיות הסכום המלא — סוגר זיכוי-עצמי מומצא.
            //  2. כל share בודד חסום ב-amount של הקנייה עצמה — כך גם
            //     בחלוקה רב-משתתפים אי אפשר לחייב קורבן ביותר ממה
            //     שהקנייה "מכריזה" שהיא עלתה (ומ-amount יש כבר תקרה
            //     נפרדת של ₪100,000).
            // עדיין לא סגור לגמרי: shares יכולים לזקוף הכל לקורבן אחד
            // בלי לחייב את התוקף בכלל. סגירה מלאה דורשת בדיקת תקינות
            // מחזורית בצד שרת (יש כבר Cloudflare Worker + GitHub Action
            // עם הרשאות Admin SDK בפרויקט לצורך כזה) — לא נבנה כאן,
            // מסומן לדיון מוצרי נפרד.
            //
            // ‼️ נבדק ונדחה במפורש (סבב אבטחה, 2026-08): "חלקו של הקונה
            // חייב להיות > 0 כשיש יותר ממשתתף אחד". שתי סיבות שהוא לא
            // מיושם, ואל תוסיפו אותו בלי לקרוא אותן:
            //
            //  1. הוא **שובר זרימה לגיטימית**. ב-MarkBoughtSheet הקונה יכול
            //     להסיר את עצמו מרשימת המשתתפים ('קניתי לשני השותפים, חצי
            //     חצי, אני לא בפנים'). אז boughtBy כלל לא מופיע ב-shares.
            //     בנוסף splitEqual של סכום זעיר בין הרבה משתתפים (2 אגורות
            //     לשלושה) מחזיר 0 לאחד מהם באופן תקין לחלוטין.
            //  2. הוא **לא מוסיף אבטחה**. תוקף שרוצה לחייב שותף בסכום מלא
            //     פשוט לא יכלול את עצמו ב-splitBetween — בדיוק כמו הזרימה
            //     הלגיטימית. כלומר הבדיקה נעקפת בלחיצה אחת.
            //
            // מסקנת האמת: הגבול כאן אינו טכני אלא מוצרי — כל חבר פעיל רשאי
            // לרשום קנייה שמחייבת שותף, כי קניות נכנסות בלי אישור מנהל.
            // מה שכן נסגר עכשיו: המנהל יכול למחוק רשומה approved (ראו .write
            // למעלה), ולכן יש שוב דרך לתקן. אכיפת sum(shares) === amount
            // שייכת ל-Worker/Action עם Admin SDK, לא לכללים.
            "shares": {
              ".validate": "newData.hasChildren() && (newData.parent().child('splitMethod').val() !== 'covered' || newData.child(newData.parent().child('boughtBy').val()).val() === newData.parent().child('amount').val())",
              "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().parent().child('amount').val() && newData.val() % 1 === 0 && newData.parent().parent().child('splitBetween/' + $uid).val() === true" }
            },

            "receipt":    { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.+/)" },
            "status":     { ".validate": "newData.val().matches(/^(pending|approved|rejected|settled)$/)" },
            "approvedBy": { ".validate": "newData.val() === auth.uid || root.child('rooms/' + $code + '/metadata/adminId').val() === newData.val()" },
            "note":       { ".validate": "newData.isString() && newData.val().length <= 300" },
            "$other":     { ".validate": false }
          }
        },

        // ---------- מאזנים (מטמון תצוגה בלבד) ----------
        // מקור האמת הוא purchases. נכתב רק ע"י המנהל בעת אישור קנייה,
        // וניתן למחיקה ובנייה מחדש בכל רגע מתוך היומן.
        "balances": {
          ".write": "auth != null && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid",
          "$uid": {
            "amount":      { ".validate": "newData.isNumber() && newData.val() % 1 === 0" },
            "lastUpdated": { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- סגירות חשבון ----------
        // יוצר: המשלם או המקבל. אישור: רק המקבל, ובלי לשנות את הסכום.
        "settlements": {
          ".indexOn": ["date", "from", "to"],
          "$settlementId": {
            // ‼️ תוקן: to לא היה קפוא בענף העדכון (רק amount/from) — הנמען
            // שמאשר קבלה יכל תיאורטית להפנות את ה-to למישהו אחר תוך כדי
            // האישור. עכשיו קפוא גם הוא.
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && !newData.child('confirmedBy').exists() && (newData.child('from').val() === auth.uid || newData.child('to').val() === auth.uid)) || (data.exists() && newData.exists() && data.child('to').val() === auth.uid && newData.child('amount').val() === data.child('amount').val() && newData.child('from').val() === data.child('from').val() && newData.child('to').val() === data.child('to').val()))",
            ".validate": "newData.hasChildren(['from', 'to', 'amount', 'date'])",
            "from":        { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },
            "to":          { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists() && newData.val() !== newData.parent().child('from').val()" },
            "amount":      { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000 && newData.val() % 1 === 0" },
            "date":        { ".validate": "newData.isNumber()" },
            // ‼️ תוקן: הכלל הקודם בדק רק שה‏ערך שווה ל-to — ולא שמי שכותב
            // אותו הוא to. חייב (from) יכול היה לכתוב confirmedBy=<uid של
            // הנושה> ולמחוק בכך את החוב שלו בלי שהנושה ראה שקל.
            // עכשיו נדרשות שתי הבדיקות יחד. בנוסף, ענף היצירה למעלה אוסר
            // confirmedBy לא-null ביצירה — createSettlement כבר כותב null
            // (src/services/purchaseService.ts) ולכן שום זרימה לגיטימית
            // לא נשברת; האישור מגיע תמיד ככתיבה שנייה של המקבל.
            "confirmedBy": { ".validate": "newData.val() === auth.uid && newData.val() === newData.parent().child('to').val()" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- התראות ----------
        // נשמרות בתוך החדר ולא בתיבה אישית, כדי שלא ניאלץ לתת לחבר אחד
        // הרשאת כתיבה לתיבה של חבר אחר. כל אחד מסמן "נקרא" רק לעצמו.
        "notifications": {
          ".indexOn": ["createdAt"],
          "$notificationId": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && (!data.exists() || root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['type', 'actorId', 'text', 'createdAt'])",
            "type":      { ".validate": "newData.val().matches(/^(item_added|item_claimed|item_bought|purchase_made|purchase_approved|purchase_rejected|member_joined|member_removed|settlement|task_added|task_assigned|task_transfer)$/)" },
            // ‼️ תוקן: הענף השני (adminId === auth.uid) לא בדק בכלל את
            // newData — כל עוד הכותב הוא המנהל, actorId יכול היה להיות
            // כל uid שהוא בחר, ולא רק שלו. אין תרחיש לגיטימי שדורש זאת:
            // בכל 10 אתרי הכתיבה (item/purchase/task/roomService) הכותב
            // תמיד רושם actorId כ-uid של עצמו. הוסר — נשאר רק "אתה יכול
            // לרשום את עצמך כמבצע הפעולה".
            "actorId":   { ".validate": "newData.val() === auth.uid" },
            // ‼️ תוקן: השדה הזה הוא מה שמוצג בפועל למשתמש (NotificationsPage),
            // וכמחרוזת חופשית חבר רגיל יכול היה לפרסם התראה בשם "מנהל החדר".
            // עכשיו הוא חייב להתאים לשם האמיתי של מי שרשום ב-actorId.
            //
            // שני מקורות מותרים, ובכוונה: הלקוח שולח לפעמים את
            // users/$uid/displayName (itemService, taskService, purchaseService)
            // ולפעמים את rooms/$code/members/$uid/name (BalancesPage). השניים
            // מסונכרנים ב-changeDisplayName, אבל יש חלון אמיתי שבו הם נבדלים:
            // מי ששינה שם בזמן שבקשת ההצטרפות שלו ממתינה — ה-fan-out מדלג
            // עליו כי users/$uid/rooms/$code עדיין לא קיים, ו-members/$uid/name
            // נכתב מ-request.displayName הישן. דרישת התאמה לאחד בלבד הייתה
            // חוסמת לו כל דיווח מוצר עד לשינוי שם נוסף.
            "actorName": { ".validate": "newData.isString() && newData.val().length <= 40 && (newData.val() === root.child('rooms/' + $code + '/members/' + newData.parent().child('actorId').val() + '/name').val() || newData.val() === root.child('users/' + newData.parent().child('actorId').val() + '/displayName').val())" },
            "text":      { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
            "entityId":  { ".validate": "newData.isString() && newData.val().length <= 40" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "readBy": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.isBoolean() && newData.val() === true"
              }
            },
            "$other": { ".validate": false }
          }
        },

        // ---------- מטלות קבועות ----------
        // סבב אוטומטי: currentAssignee הוא מי שאחראי *בפועל* עכשיו (אין
        // currentIndex נפרד — ראו הערה על Task ב-types/models.ts). היצירה
        // והמחיקה רק למנהל; העדכון (השלמה/רוטציה, או קבלת העברה) מותר
        // גם למי שהיה אחראי (data) וגם למי שהופך לאחראי (newData) — כך
        // מכסים גם "סימנתי שבוצע, התור עבר הלאה" וגם "קיבלתי העברה".
        // שאר השדות (שם/קטגוריה/תדירות/participants/createdBy/createdAt)
        // קפואים לנצח אחרי היצירה — לשנות אותם צריך למחוק וליצור מחדש.
        "tasks": {
          ".indexOn": ["dueAt"],
          "$taskId": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && (((!data.exists() || !newData.exists()) && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid) || (data.exists() && newData.exists() && (data.child('currentAssignee').val() === auth.uid || newData.child('currentAssignee').val() === auth.uid) && newData.child('name').val() === data.child('name').val() && newData.child('category').val() === data.child('category').val() && newData.child('intervalDays').val() === data.child('intervalDays').val() && newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
            ".validate": "newData.hasChildren(['name', 'category', 'intervalDays', 'participants', 'currentAssignee', 'dueAt', 'createdBy', 'createdAt'])",
            "name":            { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "category":        { ".validate": "newData.val().matches(/^(kitchen|bathroom|cleaning|other)$/)" },
            "intervalDays":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 365" },
            "participants":    { ".validate": "newData.hasChildren()" },
            "currentAssignee": { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },
            "dueAt":           { ".validate": "newData.isNumber()" },
            "createdBy":       { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists() && (!data.exists() || newData.val() === data.val())" },
            "createdAt":       { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "$other":          { ".validate": false }
          }
        },

        // ---------- יומן ביצוע מטלות ----------
        // מקור האמת להוגנות ("מי עשה כמה") — בדיוק כמו purchases לכסף.
        // הוספה בלבד, אף פעם לא נערך/נמחק.
        "taskCompletions": {
          ".indexOn": ["completedAt"],
          "$completionId": {
            ".write": "auth != null && !data.exists() && newData.exists() && newData.child('completedBy').val() === auth.uid && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",
            ".validate": "newData.hasChildren(['taskId', 'taskName', 'completedBy', 'completedAt'])",
            "taskId":      { ".validate": "newData.isString()" },
            "taskName":    { ".validate": "newData.isString() && newData.val().length <= 60" },
            "completedBy": { ".validate": "newData.val() === auth.uid" },
            "completedAt": { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- בקשות העברת תור במטלה ----------
        // אותו דפוס בדיוק כמו settlements: יצירה ע"י המבקש (fromUid, וגם
        // חייב להיות האחראי הנוכחי בפועל על המטלה), אישור/דחייה רק ע"י
        // מי שהתבקש (toUid) — סכום/צדדים קפואים בשלב האישור.
        "taskTransfers": {
          ".indexOn": ["status"],
          "$transferId": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && newData.child('fromUid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('toUid').val() !== auth.uid && root.child('rooms/' + $code + '/members/' + newData.child('toUid').val() + '/status').val() === 'active' && root.child('rooms/' + $code + '/tasks/' + newData.child('taskId').val() + '/currentAssignee').val() === auth.uid) || (data.exists() && newData.exists() && data.child('toUid').val() === auth.uid && data.child('status').val() === 'pending' && (newData.child('status').val() === 'approved' || newData.child('status').val() === 'rejected') && newData.child('taskId').val() === data.child('taskId').val() && newData.child('taskName').val() === data.child('taskName').val() && newData.child('fromUid').val() === data.child('fromUid').val() && newData.child('toUid').val() === data.child('toUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
            ".validate": "newData.hasChildren(['taskId', 'taskName', 'fromUid', 'toUid', 'status', 'createdAt'])",
            "taskId":      { ".validate": "newData.isString()" },
            "taskName":    { ".validate": "newData.isString() && newData.val().length <= 60" },
            "fromUid":     { ".validate": "newData.isString()" },
            "toUid":       { ".validate": "newData.isString()" },
            "status":      { ".validate": "newData.val().matches(/^(pending|approved|rejected)$/)" },
            "createdAt":   { ".validate": "newData.isNumber()" },
            "respondedAt": { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        },

        // ---------- הודעות שידור מהמנהל ----------
        // רק המנהל כותב (יצירה בלבד, בלי עריכה — הודעה שנשלחה נשארת
        // כמו שהיא), כל חבר פעיל קורא (יורש מ-.read של rooms/{code}).
        "announcements": {
          ".indexOn": ["sentAt"],
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms/' + $code + '/metadata/adminId').val() === auth.uid && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['senderId', 'text', 'sentAt'])",
            "senderId": { ".validate": "newData.val() === root.child('rooms/' + $code + '/metadata/adminId').val()" },
            "text":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000" },
            "sentAt":   { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },

        // ---------- צ'אט כללי של החדר ----------
        // מקונן תחת rooms/{code} בכוונה — חוק הקריאה של rooms/{code} כבר
        // מעניק גישה לכל חבר פעיל, וזה בדיוק מה שרוצים לצ'אט כללי (בניגוד
        // לצ'אט הפרטי, ראו dms למטה, שחייב להיות עצמאי ברמה העליונה
        // כי חוק read ברמת ההורה אי אפשר לצמצם שוב ברמה עמוקה יותר —
        // מגבלה מובנית של RTDB Rules).
        "chat": {
          ".indexOn": ["sentAt"],
          "$msgId": {
            // יצירה: חבר פעיל בלבד, senderId = הוא עצמו.
            // עדכון: כל חבר פעיל יכול להוסיף את עצמו ל-deliveredTo/readBy —
            // אבל לא לגעת ב-senderId/text/sentAt אחרי היצירה.
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && newData.child('senderId').val() === auth.uid) || (data.exists() && newData.exists() && newData.child('senderId').val() === data.child('senderId').val() && newData.child('text').val() === data.child('text').val() && newData.child('sentAt').val() === data.child('sentAt').val()))",
            ".validate": "newData.hasChildren(['senderId', 'text', 'sentAt'])",
            "senderId":    { ".validate": "root.child('rooms/' + $code + '/members/' + newData.val()).exists()" },
            "text":        { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000" },
            "sentAt":      { ".validate": "newData.isNumber()" },
            // ‼️ $uid === auth.uid ב-validate (לא רק write) — כל חבר פעיל
            // יכול לכתוב איפשהו בהודעה (הרשאת ה-write ברמת ההודעה כללית
            // מדי מכדי להיסגר עמוק יותר), אבל validate לא "מדלג" ככה —
            // חייב לעמוד בו בעצמו לכל שדה. בלעדיו חבר אחד היה יכול לסמן
            // readBy/deliveredTo בשם חבר אחר, ולזייף וי כחול על ההודעות שלו.
            //
            // ‼️ פער ידוע שנשאר, ובמכוון: validate אינו רץ על **מחיקה**,
            // ולכן חבר יכול למחוק את readBy/<שותף> ולהעלים לו וי כחול.
            // ההצעה "להוסיף .write ברמת readBy/$uid" **לא עובדת**: ב-RTDB
            // הרשאות write מדורגות כלפי מטה בלבד — הרשאה שניתנה ב-$msgId
            // כבר מכסה את כל הצאצאים, ואי אפשר לשלול אותה עמוק יותר. כלל
            // כזה היה קוד מת שנראה כמו הגנה. אין ניסוח שכן חוסם את זה,
            // כי אי אפשר לדרוש "המפתחות הקיימים נשמרו" על מפתחות דינמיים.
            // ההשפעה קוסמטית בלבד — **זיוף** קבלה (ההודעה נקראה) חסום, רק
            // מחיקה אפשרית. סגירה אמיתית = להעביר readBy לצומת נפרד שבו
            // ה-.write עצמו הוא לפי $uid, שינוי סכימה מחוץ להיקף התיקון.
            "deliveredTo": { "$uid": { ".validate": "newData.isBoolean() && newData.val() === true && $uid === auth.uid" } },
            "readBy":      { "$uid": { ".validate": "newData.isBoolean() && newData.val() === true && $uid === auth.uid" } },
            "$other":      { ".validate": false }
          }
        },

        // ---------- נוכחות בצ'אט ----------
        // מסך צ'אט פתוח כותב כאן חותמת זמן בכניסה ומוחק ביציאה (עם
        // onDisconnect כגיבוי לניתוק פתאומי). לפני שליחת פוש, השולח בודק
        // אם הנמען "נוכח" באותה שיחה ממש — אם כן, מדלגים על הפוש כי הוא
        // כבר רואה את זה חי. $scope הוא 'general' או pairKey של שיחה פרטית.
        "chatPresence": {
          "$scope": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",
              ".validate": "newData.isBoolean() && newData.val() === true"
            }
          }
        },

        "$other": { ".validate": false }
      }
    },

    // ---------- צ'אט פרטי (DM) ----------
    // ‼️ עצמאי ברמה העליונה, לא מקונן תחת rooms/{code} — כי חוק ה-read
    // הרחב של rooms/{code} (כל חבר פעיל) לא ניתן לצמצום שוב בעומק גדול
    // יותר; RTDB מעניקה גישה במורד העץ ולא ניתן "לשלול" אותה בהמשך.
    // אילו קיננו dm כאן, כל חבר בחדר היה יכול לקרוא כל שיחה פרטית של
    // כל שני חברים אחרים. לכן: node עצמאי, עם .read/.write צרים בעצמם.
    "dms": {
      "$code": {
        "$pairKey": {
          // ‼️ מבוסס נתיב בלבד ($pairKey.contains(auth.uid)) — לא על צומת
          // "participants" נפרד. גרסה קודמת ניסתה להסתמך על "אותה כתיבה
          // אטומית שיוצרת participants+message — אז זה כבר 'קיים' בזמן
          // האימות". זו הנחה שגויה: ב-RTDB Rules, root מייצג תמיד את מצב
          // ה-DB *לפני* הכתיבה, לא אחרי (בדיוק כמו ההערה המתועדת כבר
          // ב-staples/members ליצירת חדר — "ביצה ותרנגולת"). התוצאה
          // בפועל: ההודעה הפרטית הראשונה בין כל שני משתמשים נכשלה תמיד
          // ב-permission_denied, כי participants עוד לא היה קיים לפי
          // ה-root שהחוק בדק. $pairKey כבר מקודד את שני המשתתפים בעצמו
          // (ראו contains() למטה) — אין צורך בצומת נפרד בשביל זה.
          ".read": "auth != null && $pairKey.contains(auth.uid) && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active'",

          "messages": {
            ".indexOn": ["sentAt"],
            "$msgId": {
              ".write": "auth != null && $pairKey.contains(auth.uid) && root.child('rooms/' + $code + '/members/' + auth.uid + '/status').val() === 'active' && ((!data.exists() && newData.exists() && newData.child('senderId').val() === auth.uid) || (data.exists() && newData.exists() && newData.child('senderId').val() === data.child('senderId').val() && newData.child('text').val() === data.child('text').val() && newData.child('sentAt').val() === data.child('sentAt').val()))",
              ".validate": "newData.hasChildren(['senderId', 'text', 'sentAt'])",
              // ‼️ contains() ולא התאמה מדויקת — RTDB Rules אין להן פונקציית
              // פיצול מחרוזת. מזהי Firebase ארוכים ואקראיים מספיק שהתנגשות
              // תת-מחרוזת בפועל היא לא תרחיש ריאלי.
              "senderId":    { ".validate": "$pairKey.contains(newData.val())" },
              "text":        { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000" },
              "sentAt":      { ".validate": "newData.isNumber()" },
              // $uid === auth.uid מאותה סיבה כמו בצ'אט הכללי — ראו שם.
              "deliveredTo": { "$uid": { ".validate": "newData.isBoolean() && newData.val() === true && $uid === auth.uid && $pairKey.contains($uid)" } },
              "readBy":      { "$uid": { ".validate": "newData.isBoolean() && newData.val() === true && $uid === auth.uid && $pairKey.contains($uid)" } },
              "$other":      { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        }
      }
    }
  }
}
