# ─────────────────────────────────────────────────────────────
#  הגדרות מצב "דמו" — סביבת בדיקות מקומית מול האמולטורים בלבד
#
#  נטען אוטומטית ע"י `npm run demo` (דרך vite --mode demo), כדי
#  שבדיקה מקומית לא תדרוש להכין .env.local ביד.
#
#  ‼️ הערכים כאן מזויפים במכוון ואינם סודות. הם לעולם לא פונים
#     לשרת אמיתי: VITE_USE_EMULATORS=true מפנה את Auth ואת ה-DB
#     ל-127.0.0.1 עוד לפני הבקשה הראשונה (src/config/firebase.ts).
#     המבנה שלהם חייב להיראות תקין — getAuth מאמת את צורת ה-apiKey
#     סינכרונית בזמן טעינת המודול וזורק לפני ש-React בכלל עולה.
# ─────────────────────────────────────────────────────────────

VITE_FB_API_KEY=AIzaSyDEMO0000000000000000000000000000000
VITE_FB_AUTH_DOMAIN=demo-roommate.firebaseapp.com
VITE_FB_DATABASE_URL=http://127.0.0.1:9000/?ns=gen-lang-client-0675991189-default-rtdb
VITE_FB_PROJECT_ID=gen-lang-client-0675991189
VITE_FB_STORAGE_BUCKET=demo-roommate.appspot.com
VITE_FB_MSG_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:0000000000000000000000

VITE_USE_EMULATORS=true
