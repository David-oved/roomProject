rules_version = '2';

// ============================================================
//  RoomMate — Firebase Storage Security Rules
//  פריסה: firebase deploy --only storage
//
//  ‼️ הקובץ הזה נעול במכוון. האפליקציה **אינה משתמשת** ב-Firebase
//     Storage בכלל — כל העלאת תמונה עוברת ב-Cloudinary. ראו
//     src/services/avatarService.ts (POST ל-api.cloudinary.com,
//     ה-secure_url נשמר ב-users/{uid}/avatar) ואת ההערה ב-.env.example:
//     Firebase Storage מצריך תוכנית Blaze עם כרטיס אשראי, Cloudinary לא.
//
//     אומת בסבב האבטחה (2026-08):
//       grep -rn "firebasestorage\|firebase/storage\|getStorage" src worker scripts
//     מחזיר אפס תוצאות. ההתייחסות היחידה היא storageBucket ב-
//     src/config/firebase.ts — פרמטר קונפיגורציה שלא נעשה בו שימוש.
//
//  מה היה כאן קודם ולמה זו הייתה בעיה:
//     הכלל roomPhotos/{roomCode}/{fileName} התיר write **ו-delete** לכל
//     משתמש מחובר, בלי שום קשר לחדר. כלומר כל בעל חשבון באפליקציה יכול
//     היה למחוק או להחליף תמונות של כל חדר שקוד שלו ידוע לו, ולמלא את
//     הדלי בתוכן שרירותי על חשבון הפרויקט. גם avatars/ ו-receipts/ היו
//     פתוחים לקריאה לכל משתמש מחובר. אין סיבה להשאיר משטח תקיפה פתוח
//     לשירות שאף שורת קוד לא נוגעת בו.
//
//  ⚠️ אם וכאשר Storage ייכנס לשימוש: אל תחזירו את הכללים הישנים.
//     כתבו אותם מחדש עם קשר בעלות מפורש (request.auth.uid == userId),
//     הגבלת contentType וגודל, וזכרו את המגבלה המובנית — כללי Storage
//     אינם יכולים לקרוא מ-Realtime Database, ולכן "האם המשתמש חבר
//     בחדר?" לא ניתן לאכיפה כאן. הפתרון הנכון לזה הוא Cloud Function
//     שמנפיקה signed URLs, לא נתיב "קשה לניחוש".
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
