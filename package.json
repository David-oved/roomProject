{
  "name": "roommate",
  "private": true,
  "version": "1.12.0",
  "type": "module",
  "description": "RoomMate — ניהול חכם של חדר משותף במעונות סטודנטים",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc -b --noEmit && vite build && node scripts/stamp-build.mjs",
    "preview": "vite preview",
    "emu": "firebase emulators:start --import=./.emulator-data --export-on-exit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only database \"vitest run tests/rules\"",
    "lint": "eslint src --max-warnings 0",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check:version": "node scripts/check-version.mjs",
    "clean": "node scripts/clean.mjs",
    "test:push": "node scripts/simulate-push.mjs"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "firebase": "^10.13.2",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.2.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.1",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
